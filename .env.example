# Application configuration
APP_ID=buggy-app-001
TARGET_REPO=asel6320/bugpilot-buggy-app

# LLM configuration
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Retry configuration
MAX_FIX_ATTEMPTS=3
LLM_MAX_RETRIES=5

# GitHub configuration
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Human approval
APPROVAL_TOKEN=

# Telegram configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DB_PATH=/data/runs.db